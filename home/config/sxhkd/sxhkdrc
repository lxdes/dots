	qs ipc call screenshot toggle

ctrl + alt + v
	bspc rule -a \* -o state=floating ; pavucontrol


# --------------------- DUNST (NOTIFICATIONS) ---------------------

super + shift + Escape
	qs ipc call notifications toggle

super + shift + w
	qs ipc call wallpaper toggle

alt + shift + s
	qs ipc call settings toggle


# ====================================================================
# BSPWM WINDOW MANAGEMENT
# ====================================================================

# --- close / kill ---
super + q
	bspc node -c

# --- layout ---
super + o
	bspc desktop -l next

super + alt + o
	bsp-layout next --layouts tall,monocle,tiled

super + alt + shift + o
	bsp-layout previous --layouts tall,monocle,tiled

super + f
	bspc node -t floating

super + t
	bspc node -t tiled

super + shift + f
	bspc node -t fullscreen

# --- node flags ---
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}


# --------------------- FOCUS / SWAP ---------------------
# focus the node in the given direction
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# focus the next/previous node in the current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

ctrl + alt + {Left,Right}
	bspc node -d {prev,next} -f

ctrl + alt + {h,l}
	bspc node -d {prev,next} -f

# focus the last node/desktop
super + {grave,Tab}
	~/.config/bspwm/scripts/swap_windows.sh

# focus the older or newer node in the focus history
super + {ctrl + o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}' --follow


# --------------------- MOVE / RESIZE ---------------------
# expand a window by moving one of its sides outward
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its sides inward
super + alt + shift + {Left,Down,Up,Right}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + ctrl + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}


