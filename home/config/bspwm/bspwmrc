#!/usr/bin/env sh

#
#                 ░█▀▄░█▀▀░█▀█░█░█░█▄█
#                 ░█▀▄░▀▀█░█▀▀░█▄█░█░█
#                 ░▀▀░░▀▀▀░▀░░░▀░▀░▀░▀
#

# --- Environment ---
export ELECTRON_OZONE_PLATFORM_HINT=x11
export XDG_CURRENT_DESKTOP=bspwm

# --- Startup ---
~/.config/bspwm/scripts/autostart.sh &
xsetroot -cursor_name left_ptr &
xrdb -merge ~/.Xresources &
wmname BSPWM &

# --- Workspaces ---
bspc monitor -d 1 2 3 4 5 6 7 8 9 0

# --- Appearance ---
bspc config border_width 2
bspc config window_gap 6
[ -x "$HOME/.config/bspwm/appearance.sh" ] && "$HOME/.config/bspwm/appearance.sh"
bspc config top_padding 32
bspc config bottom_padding 0
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config focused_border_color "#bfc9f4"
bspc config normal_border_color "#13141c"

# --- Behavior ---
bspc config automatic_scheme alternate
bspc config initial_polarity second_child
bspc config split_ratio 0.5
bspc config focus_follows_pointer true

# --- Window rules ---
bspc rule -a Gtk-file-chooser state=floating rectangle=1600x1100+1120+650 center=true
bspc rule -a Pavucontrol state=floating rectangle=1400x1000+1220+700
bspc rule -a BoltLauncher state=floating center=true rectangle=1600x1100+1120+650
bspc rule -a net-runelite-client-RuneLite state=floating center=true
bspc rule -a Engrampa state=floating layer=normal
bspc rule -a org.gnome.FileRoller state=floating
bspc rule -a scratchpad state=floating
